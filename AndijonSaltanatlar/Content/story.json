  "Dialogues": [
    {
      "DialogueId": "d_b1_intro",
      "Speaker": "Vazir",
      "TextUz": "Xush kelibsiz, hukmdorim! Shahrimizning kelajagi sizning qarorlaringizga bog\u0027liq. Avvalo xalqimiz uchun munosib yashash sharoitini yaratamiz.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": "d_b1_memor"
    },
    {
      "DialogueId": "d_b1_memor",
      "Speaker": "Memor",
      "TextUz": "Hazratim, shahrimizda yangi turar joy qurish uchun qulay joy topdik. Nima qilaylik?",
      "Choices": [
        {
          "TextUz": "Qurilishni boshlashga tayyorgarlik ko\u0027ring.",
          "ConsequenceKey": "choice_build_now",
          "NextDialogueId": ""
        },
        {
          "TextUz": "Kerakli resurslarni hisoblang.",
          "ConsequenceKey": "choice_plan",
          "NextDialogueId": ""
        },
        {
          "TextUz": "Bu taklifni keyinga qoldiramiz.",
          "ConsequenceKey": "choice_delay",
          "NextDialogueId": ""
        }
      ],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b2_intro",
      "Speaker": "Vazir",
      "TextUz": "Hazratim, shahrimiz kengaymoqda. Endi aholimizning kundalik ehtiyojlari va savdo imkoniyatlarini yaxshilashimiz zarur.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b3_intro",
      "Speaker": "Vazir",
      "TextUz": "Shahrimiz tor bo\u0027lib qoldi, hukmdorim. Yangi mahallalar ochish vaqti keldi.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b3_hint",
      "Speaker": "Vazir",
      "TextUz": "Yangi yer ochish uchun xazina va aholi talablari bor. \u0027XARITADA KO\u0027RSAT\u0027 tugmasi sizni tegishli uchastkaga olib boradi.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b4_intro",
      "Speaker": "Muallim",
      "TextUz": "Hazratim, ilm va madaniyatni rivojlantirsak, saltanatimiz asrlar osha yashaydi.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b5_intro",
      "Speaker": "Savdogar",
      "TextUz": "Hazratim, rivojlangan shahar boshqa hududlar bilan savdo va hamkorlik orqali yanada yuksaladi.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b6_intro",
      "Speaker": "Elchi",
      "TextUz": "Hazratim, qo\u0027shni davlatlar bilan birlik va ittifoq saltanatimizni mustahkamlaydi.",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b7_intro",
      "Speaker": "Vazir",
      "TextUz": "Hukmdorim, biz uzoq yo\u0027l bosib o\u0027tdik. Endi Asakani buyuk poytaxtga aylantirish vaqti!",
      "Choices": [],
      "Conditions": {},
      "Consequences": {},
      "NextDialogueId": ""
    },
    {
      "DialogueId": "d_b7_outro",
      "Speaker": "Vazir",
      "TextUz": "Tabriklayman, hukmdorim! Asaka endi rivojlangan saltanat markazi. Xalqimiz sizdan minnatdor.",
